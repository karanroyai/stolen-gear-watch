# Copy this file to .env and fill in real values. .env is gitignored.

# --- Telegram alerting (required for the built-in notifier) ---
# Create a bot via @BotFather, then message it once and fetch the chat id
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Reverse image search (optional - leave blank to use manual-check links) ---
GOOGLE_APPLICATION_CREDENTIALS=
TINEYE_PUBLIC_KEY=
TINEYE_PRIVATE_KEY=

# --- Scraper etiquette ---
# Sent as the User-Agent + used in adapters' contact info. Set this to
# something that identifies your instance so site operators can reach you
# if there's an issue, per good scraping citizenship.
SCRAPER_CONTACT_EMAIL=
