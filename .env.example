# Copy this file to .env and fill in real values. .env is gitignored.

# --- Telegram alerting (required for the built-in notifier) ---
# Create a bot via @BotFather, then message it once and fetch the chat id
# from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Reverse image search (optional - leave blank to use manual-check links) ---
GOOGLE_APPLICATION_CREDENTIALS=
TINEYE_PUBLIC_KEY=
TINEYE_PRIVATE_KEY=

# --- eBay scraper adapter (uses the official Browse API, not scraping) ---
# Free account + app registration at https://developer.ebay.com, client
# credentials grant (no eBay user login involved). Leave blank to disable -
# the adapter logs a clear error each run rather than crashing if enabled
# without credentials.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional - comma-separated eBay sites to search, e.g. "EBAY_DE,EBAY_AT,EBAY_PL".
# Defaults to EBAY_DE,EBAY_AT,EBAY_PL (the only genuine Central/Eastern
# European eBay marketplaces - see scrapers/ebay.py's docstring) if unset.
EBAY_MARKETPLACE_IDS=
# Legacy single-value override, still honored if EBAY_MARKETPLACE_IDS is unset.
EBAY_MARKETPLACE_ID=

# --- General web search (Google Custom Search JSON API - a real API, not
# scraping google.com/search) ---
# Enable the "Custom Search API" in a Google Cloud project for the key,
# and create a search engine configured for the whole web at
# https://programmablesearchengine.google.com/ for the engine ID ("cx").
# Free for 100 queries/day. Leave blank to disable.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=

# --- Scraper etiquette ---
# Sent as the User-Agent + used in adapters' contact info. Set this to
# something that identifies your instance so site operators can reach you
# if there's an issue, per good scraping citizenship.
SCRAPER_CONTACT_EMAIL=
